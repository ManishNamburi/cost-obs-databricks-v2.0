resources:
  # Lakebase Autoscaling project — new provisioned databases deprecated after 2026-03-12.
  # Use postgres_projects (Autoscaling) for all new V2 deployments.
  postgres_projects:
    cost_obs_db:
      name: ${var.lakebase_project_name}
      capacity: CU_4
      region: auto

  postgres_branches:
    cost_obs_main:
      project_id: ${resources.postgres_projects.cost_obs_db.id}
      name: main

  postgres_endpoints:
    cost_obs_endpoint:
      project_id: ${resources.postgres_projects.cost_obs_db.id}
      branch_id: ${resources.postgres_branches.cost_obs_main.id}
      name: ${var.lakebase_endpoint_name}
      enabled: true
